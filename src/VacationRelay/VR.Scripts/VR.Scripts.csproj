<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

	<ItemGroup>
		<PackageReference Include="rscgutils" Version="2025.2412.724" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />

	</ItemGroup>
	<ItemGroup>
		<AdditionalFiles Include="SqlServer01.createTables.gen.txt" />
		<AdditionalFiles Include="PostgreSQL01.createTables.gen.txt" />
	</ItemGroup>
	
	<PropertyGroup>
		<EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
		<CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)\GeneratedX</CompilerGeneratedFilesOutputPath>
	</PropertyGroup>

</Project>
